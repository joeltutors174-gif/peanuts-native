diff --git a/android/app/src/main/java/dev/nxnative/android/AuroraText.java b/android/app/src/main/java/dev/nxnative/android/AuroraText.java
new file mode 100644
index 0000000..342b035
--- /dev/null
+++ b/android/app/src/main/java/dev/nxnative/android/AuroraText.java
@@ -0,0 +1,100 @@
+package dev.nxnative.android;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.os.LocaleList;
+import android.text.method.TransformationMethod;
+import android.view.View;
+import android.widget.TextView;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/** The Aurora UI language. Existing setting keys and action labels stay canonical. */
+public final class AuroraText {
+    private static final Locale BRAZIL = Locale.forLanguageTag("pt-BR");
+    private static final String[] OPTIONS = {"", "pt-BR", "en"};
+    private static Map<String, String> portuguese;
+
+    private AuroraText() {}
+
+    private static SharedPreferences preferences(Context c) {
+        return c.getSharedPreferences("aurora_ui", Context.MODE_PRIVATE);
+    }
+
+    private static int choice(Context c) {
+        String saved = preferences(c).getString("language", "");
+        for (int i = 1; i < OPTIONS.length; i++) if (OPTIONS[i].equals(saved)) return i;
+        return 0;
+    }
+
+    static boolean isPortuguese(Context c) {
+        int choice = choice(c);
+        if (choice != 0) return choice == 1;
+        LocaleList locales = Resources.getSystem().getConfiguration().getLocales();
+        return !locales.isEmpty() && "pt".equals(locales.get(0).getLanguage());
+    }
+
+    private static Resources resources(Context c, Locale locale) {
+        Configuration config = new Configuration(c.getResources().getConfiguration());
+        config.setLocales(new LocaleList(locale));
+        return c.createConfigurationContext(config).getResources();
+    }
+
+    static String string(Context c, int id, Object... args) {
+        return resources(c, isPortuguese(c) ? BRAZIL : Locale.ENGLISH).getString(id, args);
+    }
+
+    private static synchronized Map<String, String> translations(Context c) {
+        if (portuguese == null) {
+            String[] keys = resources(c, Locale.ENGLISH).getStringArray(R.array.aurora_labels);
+            String[] values = resources(c, BRAZIL).getStringArray(R.array.aurora_labels);
+            portuguese = new HashMap<>();
+            for (int i = 0; i < keys.length; i++) portuguese.put(keys[i], values[i]);
+        }
+        return portuguese;
+    }
+
+    public static String label(Context c, String english) {
+        return isPortuguese(c) ? translations(c).getOrDefault(english, english) : english;
+    }
+
+    /** Preserve getText() for code that locates rows, headings and actions by their original names. */
+    public static void showTranslated(TextView view, boolean uppercase) {
+        view.setTransformationMethod(new TransformationMethod() {
+            @Override public CharSequence getTransformation(CharSequence text, View target) {
+                if (text == null) return null;
+                String original = text.toString();
+                String visible = label(target.getContext(), original);
+                if (!uppercase && original.equals(visible)) return text;
+                return uppercase ? visible.toUpperCase(isPortuguese(target.getContext()) ? BRAZIL : Locale.ENGLISH) : visible;
+            }
+            @Override public void onFocusChanged(View v, CharSequence s, boolean focused, int direction, android.graphics.Rect previous) {}
+        });
+    }
+
+    public static void translateLabel(TextView view) { showTranslated(view, false); }
+
+    static String selection(Context c) { return languageNames(c)[choice(c)]; }
+
+    private static String[] languageNames(Context c) {
+        return new String[] {string(c, R.string.aurora_language_system), "Português (Brasil)", "English"};
+    }
+
+    static void pick(Activity a, Runnable refresh) {
+        new PadFocus.Builder(a).setTitle(string(a, R.string.aurora_language))
+                .setSingleChoiceItems(languageNames(a), choice(a), (dialog, position) -> {
+                    if (position != choice(a)) {
+                        preferences(a).edit().putString("language", OPTIONS[position]).apply();
+                        dialog.dismiss();
+                        refresh.run();
+                    } else dialog.dismiss();
+                })
+                .setNegativeButton(label(a, "Cancel"), null)
+                .show();
+    }
+}
